# Environment Variables Template
# Copy this to .env.local and fill in your values

# ─── Supabase ───────────────────────────────────────────────
# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Google Gemini ───────────────────────────────────────────
# Get from https://aistudio.google.com/app/apikey
# NEVER expose this to the client (no NEXT_PUBLIC_ prefix)
GEMINI_API_KEY=

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Demo Mode ───────────────────────────────────────────────
# Set to "true" to always serve mock data (no Supabase needed)
NEXT_PUBLIC_DEMO_MODE=false

# ─── Web Push (optional) ────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@herturn.app

# ─── Notes ──────────────────────────────────────────────────
# If Supabase and Gemini keys are not set, the app runs in 
# demo mode automatically with realistic mock data.
# No setup required for a quick demo!
